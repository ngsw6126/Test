# ===== 必須 =====
# Claude API（ネットリサーチと投稿文の生成）
ANTHROPIC_API_KEY=

# ===== あると便利（API登録は不要）=====
# 楽天アフィリエイトID。あれば商品URLからアフィリエイトリンクを自動で作る
RAKUTEN_AFFILIATE_ID=

# ===== 任意（無くても動く）=====
# 楽天ウェブサービス: 料率の自動確認
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# Threads API: 自動投稿と成績の自動取得（settings.yaml の posting.mode を auto にする）
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
