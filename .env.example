# Claude APIのキーは不要です（Claude Codeのスケジュールタスクが調査と下書きを担当します）。
# 以下はすべて任意です。

# 楽天アフィリエイトID（settings.yaml の rakuten.affiliate_id に書いてもよい）
RAKUTEN_AFFILIATE_ID=
# 楽天ウェブサービス: 料率の自動確認
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# Threads API: 自動投稿と成績の自動取得（settings.yaml の posting.mode を auto にする）
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
